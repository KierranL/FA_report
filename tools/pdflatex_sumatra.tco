<?xml version="1.0" encoding="ISO-8859-1" standalone="no"?>
<txcop:outputProfiles version="2" xmlns:txcop="http://schemas.ToolsCenter.org/TeXnicCenter/OutputProfiles.xsd">
	<outputProfileList>
		<outputProfile name="LaTeX =&gt; PDF" stopOnLatexError="false">
			<texCommand execute="true" path="C:\Program Files\MiKTeX 2.9\miktex\bin\x64\pdflatex.exe" arguments="-shell-escape -max-print-line=120 -interaction=nonstopmode -synctex=-1 &quot;%pm&quot;"/>
			<bibTexCommand execute="true" path="C:\Program Files\MiKTeX 2.9\miktex\bin\x64\bibtex.exe" arguments="&quot;%tm&quot;"/>
			<makeIndexCommand execute="true" path="C:\Program Files\MiKTeX 2.9\miktex\bin\x64\makeindex.exe" arguments="&quot;%tm.idx&quot; -t &quot;%tm.ilg&quot; -o &quot;%tm.ind&quot;"/>
			<preProcessors/>
			<postProcessors/>
			<viewer path="C:\Program Files (x86)\SumatraPDF\SumatraPDF.exe -inverse-search &quot;\&quot;C:\Program Files\TeXnicCenter\TeXnicCenter.exe\&quot; /ddecmd \&quot;[goto('%f','%l')]\&quot;&quot;" closeBeforeCompilation="true">
				<viewProjectCommand type="dde">
					<commandLineCommand path="" arguments=""/>
					<ddeCommand path="C:\Program Files (x86)\SumatraPDF\SumatraPDF.exe -inverse-search &quot;\&quot;C:\Program Files\TeXnicCenter\TeXnicCenter.exe\&quot; /ddecmd \&quot;[goto('%f','%l')]\&quot;&quot;" server="SUMATRA" topic="control" command="[Open(&quot;%bm.pdf&quot;,0,1,1)]"/>
				</viewProjectCommand>
				<viewCurrentFileCommand type="dde">
					<commandLineCommand path="" arguments=""/>
					<ddeCommand path="C:\Program Files (x86)\SumatraPDF\SumatraPDF.exe -inverse-search &quot;\&quot;C:\Program Files\TeXnicCenter\TeXnicCenter.exe\&quot; /ddecmd \&quot;[goto('%f','%l')]\&quot;&quot;" server="SUMATRA" topic="control" command="[ForwardSearch(&quot;%bm.pdf&quot;,&quot;%Wc&quot;,%l,0,0,1)]"/>
				</viewCurrentFileCommand>
				<viewCloseCommand type="dde">
					<commandLineCommand path="" arguments=""/>
					<ddeCommand path="" server="acroviewR11" topic="control" command="[DocClose(&quot;%bm.pdf&quot;)]"/>
				</viewCloseCommand>
			</viewer>
		</outputProfile>
	</outputProfileList>
</txcop:outputProfiles>